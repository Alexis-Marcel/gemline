# Account provider (any OIDC issuer; in production the Compte Eriphe / Authentik).
# Public client with PKCE: nothing secret here. Register http://localhost:5173/auth/callback
# as a redirect URI on the provider for local dev.
VITE_OIDC_ISSUER=https://auth.eriphe.com/application/o/gemline/
VITE_OIDC_CLIENT_ID=gemline
